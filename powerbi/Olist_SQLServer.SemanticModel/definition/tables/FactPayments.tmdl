	partition FactPayments = m
		mode: import
		source =
				let
				    Source = Sql.Databases("SQLSERVER-DEMO\SQLEXPRESS"),
				    OlistDW = Source{[Name="OlistDW"]}[Data],
				    dbo_FactPayments = OlistDW{[Schema="dbo",Item="FactPayments"]}[Data]
				in
