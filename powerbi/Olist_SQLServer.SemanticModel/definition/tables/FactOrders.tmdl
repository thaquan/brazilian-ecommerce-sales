	partition FactOrders = m
		mode: import
		source =
				let
				    Source = Sql.Databases("SQLSERVER-DEMO\SQLEXPRESS"),
				    OlistDW = Source{[Name="OlistDW"]}[Data],
				    dbo_FactOrders = OlistDW{[Schema="dbo",Item="FactOrders"]}[Data]
				in
