table FactOrders
	lineageTag: 8988e87a-a527-5c10-837c-0a62714459e2

	measure 'Total Orders' = COUNTROWS(FactOrders)
		formatString: #,0
		displayFolder: Olist KPIs
		lineageTag: 40f80f42-79f1-5cb5-b116-7824ffbd64dd

	measure 'Ordering Customers' = DISTINCTCOUNT(FactOrders[customer_key])
		formatString: #,0
		displayFolder: Olist KPIs
		lineageTag: 94a8f9f5-542c-5720-aaa9-ccb86e9f3785

	measure 'Delivered Orders' = CALCULATE([Total Orders],KEEPFILTERS(FactOrders[order_status]="delivered"))
		formatString: #,0
		displayFolder: Olist KPIs
		lineageTag: 77b2e9b0-de8a-5df9-adc4-e4b2e7417c6b

	measure 'Canceled Orders' = CALCULATE([Total Orders],KEEPFILTERS(FactOrders[order_status]="canceled"))
		formatString: #,0
		displayFolder: Olist KPIs
		lineageTag: 19e51e5c-0267-5375-b4da-43a2d5d821c4

	measure 'Cancellation Rate' = DIVIDE([Canceled Orders],[Total Orders])
		formatString: 0.00%
		displayFolder: Olist KPIs
		lineageTag: e38f9612-07c7-563b-9e43-90cf1e6d3888

	measure 'Delivery SLA Eligible Orders' = CALCULATE([Total Orders],KEEPFILTERS(FactOrders[order_status]="delivered"),KEEPFILTERS(NOT ISBLANK(FactOrders[is_late])))
		formatString: #,0
		displayFolder: Olist KPIs
		lineageTag: 4dccd83f-0201-57ee-a303-48e3080415fe

	measure 'Late Delivered Orders' = CALCULATE([Total Orders],KEEPFILTERS(FactOrders[order_status]="delivered"),KEEPFILTERS(FactOrders[is_late]=1))
		formatString: #,0
		displayFolder: Olist KPIs
		lineageTag: 71f08aec-29b2-5a54-b90f-816b3b53a6a3

	measure 'Late Delivery Rate' = DIVIDE([Late Delivered Orders],[Delivery SLA Eligible Orders])
		formatString: 0.00%
		displayFolder: Olist KPIs
		lineageTag: 44b25be5-ebde-548b-b688-c20be9169ffc

	measure 'Average Delivery Days' = CALCULATE(AVERAGE(FactOrders[delivery_days]),KEEPFILTERS(FactOrders[order_status]="delivered"),KEEPFILTERS(NOT ISBLANK(FactOrders[delivery_days])),KEEPFILTERS(FactOrders[delivery_days]>=0))
		formatString: 0.00
		displayFolder: Olist KPIs
		lineageTag: ee597170-ced9-5cd6-b7fd-0683a0563d32

	measure 'Average Review Score' = AVERAGE(FactOrders[review_score])
		formatString: 0.00
		displayFolder: Olist KPIs
		lineageTag: 9c103d7e-d8de-5462-b4d6-4de913476ce9

	measure 'Reviewed Orders' = COUNT(FactOrders[review_score])
		formatString: #,0
		displayFolder: Olist KPIs
		lineageTag: b84f5722-2475-525f-9fe7-2ce9676f6cfc

	measure 'Review Coverage' = DIVIDE([Reviewed Orders],[Total Orders])
		formatString: 0.00%
		displayFolder: Olist KPIs
		lineageTag: 7b33d27f-6435-5ca2-a66b-688554046155

	measure 'Delivered Orders by Delivery Date' = CALCULATE([Delivered Orders],USERELATIONSHIP(FactOrders[delivered_date_key],DimDate[date_key]))
		formatString: #,0
		displayFolder: Olist KPIs
		lineageTag: bf45b42c-11f2-553c-bfc3-eecc357ff1a9

	/// Customers with more than one order within current filters, including all statuses.
	measure 'Repeat Customers (Period)' = COUNTROWS ( FILTER ( VALUES ( FactOrders[customer_key] ), NOT ISBLANK ( FactOrders[customer_key] ) && CALCULATE ( COUNTROWS ( FactOrders ) ) > 1 ) )
		formatString: #,0
		displayFolder: Report metrics
		lineageTag: 4cd92643-7842-54be-a2bc-afd4aac2aeef

	measure 'Repeat Rate (Period)' = DIVIDE ( COUNTROWS ( FILTER ( VALUES ( FactOrders[customer_key] ), NOT ISBLANK ( FactOrders[customer_key] ) && CALCULATE ( COUNTROWS ( FactOrders ) ) > 1 ) ), DISTINCTCOUNT ( FactOrders[customer_key] ) )
		formatString: 0.0%
		displayFolder: Report metrics
		lineageTag: d4a38330-b698-5f6a-a394-e10275dd7922

	measure 'Orders per Customer' = DIVIDE ( COUNTROWS ( FactOrders ), DISTINCTCOUNT ( FactOrders[customer_key] ) )
		formatString: 0.00
		displayFolder: Report metrics
		lineageTag: 1bb6a6dc-a49f-5619-a9c3-0994ad960b67

	measure 'On-Time Review' = CALCULATE ( AVERAGE ( FactOrders[review_score] ), KEEPFILTERS ( FactOrders[order_status] = "delivered" ), KEEPFILTERS ( NOT ISBLANK ( FactOrders[is_late] ) ), KEEPFILTERS ( FactOrders[is_late] = 0 ) )
		formatString: 0.00
		displayFolder: Report metrics
		lineageTag: d9110c0b-6d03-506b-a77e-09cb4bb78f8a

	measure 'Late Review' = CALCULATE ( AVERAGE ( FactOrders[review_score] ), KEEPFILTERS ( FactOrders[order_status] = "delivered" ), KEEPFILTERS ( FactOrders[is_late] = 1 ) )
		formatString: 0.00
		displayFolder: Report metrics
		lineageTag: 58fdde64-489c-5a7f-aa31-55aedae9e026

