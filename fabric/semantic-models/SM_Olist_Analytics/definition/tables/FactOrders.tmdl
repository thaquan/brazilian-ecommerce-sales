table FactOrders
	lineageTag: f34d12b2-63c0-5f35-8446-4098ec1fa340
	sourceLineageTag: [dbo].[FactOrders]

	measure 'Total Orders' =

			COUNTROWS ( FactOrders )
		formatString: 0
		lineageTag: 4efcb80c-9745-536e-b891-3ee92ccfa4fa

		changedProperty = Name

	measure 'Ordering Customers' =

			DISTINCTCOUNT ( FactOrders[customer_key] )
		formatString: 0
		lineageTag: 9e64670a-c874-538c-9a64-0c055d24989c

		changedProperty = Name

	measure 'Delivered Orders' =

			CALCULATE (
			    [Total Orders],
			    KEEPFILTERS ( FactOrders[order_status] = "delivered" )
			)
		formatString: 0
		lineageTag: 74d55728-988a-593c-a109-0e780fe6855b

		changedProperty = Name

	measure 'Canceled Orders' =

			CALCULATE (
			    [Total Orders],
			    KEEPFILTERS ( FactOrders[order_status] = "canceled" )
			)
		formatString: 0
		lineageTag: c68fcfff-faa7-50b0-a1c0-e3a65c5ba882

		changedProperty = Name

	measure 'Cancellation Rate' =

			DIVIDE (
			    [Canceled Orders],
			    [Total Orders]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e670f2ee-d3de-52b6-ba93-12a270dc3b57

		changedProperty = Name

		changedProperty = FormatString

	measure 'Delivery SLA Eligible Orders' =

			CALCULATE (
			    [Total Orders],
			    KEEPFILTERS ( FactOrders[order_status] = "delivered" ),
			    KEEPFILTERS ( NOT ISBLANK ( FactOrders[is_late] ) )
			)
		formatString: 0
		lineageTag: 9fcaa694-5975-5bea-a26d-5706917cc1d9

		changedProperty = Name

	measure 'Late Delivered Orders' =

			CALCULATE (
			    [Total Orders],
			    KEEPFILTERS ( FactOrders[order_status] = "delivered" ),
			    KEEPFILTERS ( FactOrders[is_late] = 1 )
			)
		formatString: 0
		lineageTag: e56bb193-267d-53a8-9596-f9541723ac3d

		changedProperty = Name

	measure 'Late Delivery Rate' =

			DIVIDE (
			    [Late Delivered Orders],
			    [Delivery SLA Eligible Orders]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b5a95803-a3ff-5820-910d-03d24139ff00

		changedProperty = Name

		changedProperty = FormatString

	measure 'Average Delivery Days' =

			CALCULATE (
			    AVERAGE ( FactOrders[delivery_days] ),
			    KEEPFILTERS ( FactOrders[order_status] = "delivered" ),
			    KEEPFILTERS ( NOT ISBLANK ( FactOrders[delivery_days] ) ),
			    KEEPFILTERS ( FactOrders[delivery_days] >= 0 )
			)
		formatString: #,0.00
		lineageTag: 8ef124ce-edc2-510b-bad6-06f9f201e89e

		changedProperty = Name

		changedProperty = FormatString

	measure 'Average Review Score' =

			AVERAGE ( FactOrders[review_score] )
		formatString: #,0.00
		lineageTag: 66cda74e-ea49-54a4-9c07-311deba3d481

		changedProperty = Name

		changedProperty = FormatString

	measure 'Reviewed Orders' =

			COUNT ( FactOrders[review_score] )
		formatString: 0
		lineageTag: 0b908c2a-dee6-59fc-9678-19c5280ad551

		changedProperty = Name

	measure 'Review Coverage' =

			DIVIDE (
			    [Reviewed Orders],
			    [Total Orders]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6dfbc526-762c-566b-a01f-122777c9b6aa

		changedProperty = Name

		changedProperty = FormatString

	measure 'Delivered Orders by Delivery Date' =

			CALCULATE (
			    [Delivered Orders],
			    USERELATIONSHIP (
			        DimDate[date_key],
			        FactOrders[delivered_date_key]
			    )
			)
		formatString: 0
		lineageTag: f7ce8dae-8da7-5aef-818e-b9c86d77cf23

		changedProperty = Name

