table FactOrderItem
	lineageTag: 55b95f61-e955-5984-a815-27ee484d98e6
	sourceLineageTag: [dbo].[FactOrderItem]

	measure 'Merchandise Value' =

			SUM ( FactOrderItem[price] )
		lineageTag: c40ad1b9-ea0c-57c4-aa40-da8b703b2d66

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Freight Value' =

			SUM ( FactOrderItem[freight_value] )
		lineageTag: af8f8dba-c53a-5a05-b6f2-8ba2636d9723

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Order Value Including Freight' =

			SUM ( FactOrderItem[item_gmv] )
		lineageTag: fb2f4dc8-8dd2-5fef-beaf-0edcbf922e2e

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Order Items' =

			COUNTROWS ( FactOrderItem )
		formatString: 0
		lineageTag: cd8402b8-9728-51a9-a904-a73dace1b852

		changedProperty = Name

	measure 'Orders With Items' =

			DISTINCTCOUNT ( FactOrderItem[order_id] )
		formatString: 0
		lineageTag: e4848f43-eb0c-5473-9ba2-73554de4c2ea

		changedProperty = Name

	measure 'Average Order Value' =

			DIVIDE (
			    [Order Value Including Freight],
			    [Orders With Items]
			)
		lineageTag: d3b23797-ee98-5920-b510-2b0c5a392945

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

